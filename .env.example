# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys

# Required: Your OpenRouter API key
OPENROUTER_API_KEY=

# Required: The model identifier to use
# Example: anthropic/claude-3.5-haiku
OPENROUTER_MODEL=

# Optional: Your site URL for attribution and analytics
# If not provided, defaults to empty string
OPENROUTER_SITE_URL=

# Optional: Your application name for identification
# If not provided, defaults to "Cadre AI Support Chatbot"
OPENROUTER_APP_NAME=
